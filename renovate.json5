{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  'git-submodules': {
    enabled: true,
  },
  customManagers: [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.chezmoidata/runtimes\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+:\\s*[\\x22\\x27](?<currentValue>[^\\x22\\x27]+)[\\x22\\x27]"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dot_vim/settings/plugins\\.vim$/",
        "/^dot_config/nvim/init\\.lua$/"
      ],
      "matchStrings": [
        "renovate: datasource=git-refs depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+)\\n[^\\n]*?(?:\\x27commit\\x27:|commit\\s*=)\\s*[\\x22\\x27](?<currentDigest>[a-f0-9]{40})[\\x22\\x27]"
      ],
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dot_config/nvim/init\\.lua$/"
      ],
      "matchStrings": [
        "renovate: datasource=(?<datasource>github-tags) depName=(?<depName>\\S+)\\s+version\\s*=\\s*\\x22(?<currentValue>[^\\x22]+)\\x22"
      ]
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/home/\\.bashrc\\.d/.*\\.bash$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+local ?[A-Za-z0-9_]+?_version\\s*=\\s*["\']?(?<currentValue>.+?)["\']?\\s',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.chezmoiexternals/.*\\.toml$/',
      ],
      matchStrings: [
        '(\\{\\{-?\\s*/\\*|#) renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (?:packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(\\s+\\*/\\s*-?\\}\\})?\\s+\\{\\{-?\\s*\\$[A-Za-z0-9_]+?Version\\s*:=\\s*["\']?(?<currentValue>.+?)["\']?\\s*-?\\}\\}',
      ],
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.chezmoiexternals/.*\\.toml$/',
      ],
      matchStrings: [
        '\\{\\{/\\* renovate: datasource=git-refs depName=(?<depName>[^\\s]+?) packageName=(?<packageName>[^\\s]+?) currentValue=(?<currentValue>[^\\s]+?) \\*/\\}\\}\\s+\\{\\{-?\\s*\\$[A-Za-z0-9_]+?Commit\\s*:=\\s*["\']?(?<currentDigest>[a-f0-9]{40})["\']?\\s*-?\\}\\}',
      ],
      datasourceTemplate: 'git-refs',
    },
  ],
}
