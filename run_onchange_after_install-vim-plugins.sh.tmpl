#!/bin/sh

set -eu

# Vim plugin configuration hash: {{ include "dot_vim/settings/plugins.vim" | sha256sum }}

if ! command -v vim >/dev/null 2>&1; then
    echo "vim is required to install Vim plugins" >&2
    exit 1
fi

if [ ! -f "$HOME/.vim/autoload/plug.vim" ]; then
    echo "vim-plug was not installed at $HOME/.vim/autoload/plug.vim" >&2
    exit 1
fi

# Load declarations without the interactive config. vim-plug also sources file
# detection and reloads plugins after updating, so suppress editor autocommands
# for the entire batch run, including startup and shutdown.
# Keep a verbose log so silent Ex mode cannot hide startup or hook errors.
log_dir=$(mktemp -d)
trap 'rm -rf "$log_dir"' EXIT HUP INT TERM

if vim -N --cmd 'set eventignore=all' --noplugin \
    -u "$HOME/.vim/settings/plugins.vim" -n -es -i NONE \
    -V1"$log_dir/verbose" \
    -c 'PlugUpdate --sync' \
    -c 'qa' >"$log_dir/output" 2>&1; then
    :
else
    if [ -s "$log_dir/verbose" ]; then
        cat "$log_dir/verbose" >&2
    else
        cat "$log_dir/output" >&2
    fi
    exit 1
fi
